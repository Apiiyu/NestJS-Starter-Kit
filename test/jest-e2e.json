{
  "moduleFileExtensions": ["js", "json", "ts"],
  "globalSetup": "./e2e-global-setup.ts",
  "globalTeardown": "./e2e-global-teardown.ts",
  "maxWorkers": 1,
  "rootDir": ".",
  "testEnvironment": "node",
  "testTimeout": 60000,
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "@swc/jest",
      {
        "jsc": {
          "target": "es2023",
          "parser": {
            "syntax": "typescript",
            "decorators": true
          },
          "transform": {
            "legacyDecorator": true,
            "decoratorMetadata": true
          }
        }
      }
    ]
  }
}
