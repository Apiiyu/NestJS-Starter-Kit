{
  "name": "nestjs-starter-kit",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "MIT",
  "engines": {
    "bun": ">=1.2",
    "node": ">=24 <25"
  },
  "packageManager": "bun@1.3.12",
  "scripts": {
    "audit:ci": "bun scripts/audit-gate.ts",
    "build": "nest build",
    "commitizen": "cz",
    "coverage:ratchet": "bun scripts/coverage-ratchet.ts",
    "dev:down": "docker compose down",
    "dev:logs": "docker compose logs -f postgres redis redis-queue mailpit",
    "dev:reset": "docker compose down -v",
    "dev:up": "docker compose up -d postgres redis redis-queue mailpit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "generate:module": "bun generate-module.mjs",
    "sbom": "bun scripts/generate-sbom.ts",
    "sbom:validate": "bun scripts/validate-sbom.ts",
    "seed:run": "bunx typeorm-extension seed:run -d ./src/database/postgres/postgres-data-source.ts",
    "start": "nest start",
    "start:dev": "bun lint-check.mjs && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "bun dist/main.js",
    "lint:check": "bun lint-check.mjs",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typeorm": "bun node_modules/typeorm/cli.js -d ./src/database/postgres/postgres-data-source.ts",
    "migration:create": "bunx typeorm migration:create ./src/database/postgres/migrations/Migration",
    "migration:generate": "bun run typeorm migration:generate",
    "migration:revert": "bun run typeorm migration:revert",
    "migration:run": "bun run typeorm migration:run",
    "migration:show": "bun run typeorm migration:show",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:unit": "jest --testPathPattern='spec.ts' --coverage",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:coverage": "jest --config ./test/jest-e2e.json --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@keyv/redis": "^5.1.6",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/typeorm": "11.0.3",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.66.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.206.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.206.0",
    "@opentelemetry/sdk-metrics": "^2.1.0",
    "@opentelemetry/sdk-node": "^0.206.0",
    "bcrypt": "6.0.0",
    "bullmq": "5.81.3",
    "cache-manager": "^7.2.9",
    "chalk": "5.6.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.1",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "ioredis": "6.0.0",
    "keyv": "^5.6.0",
    "nestjs-pino": "4.6.1",
    "nodemailer": "^9.0.4",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.0",
    "typeorm-extension": "4.0.0-beta.3"
  },
  "overrides": {
    "jsonwebtoken": "9.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@faker-js/faker": "^10.5.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@swc/core": "1.15.47",
    "@swc/jest": "0.2.39",
    "@types/bcrypt": "6.0.0",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-sonarjs": "4.0.3",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "lint-staged": "16.4.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "testcontainers": "^12.0.4",
    "ts-loader": "9.6.2",
    "typescript": "6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "@swc/jest",
        {
          "jsc": {
            "target": "es2023",
            "parser": {
              "syntax": "typescript",
              "decorators": true
            },
            "transform": {
              "legacyDecorator": true,
              "decoratorMetadata": true
            }
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.module.ts",
      "!**/*.entity.ts",
      "!**/*.dto.ts",
      "!**/*.constant.ts",
      "!**/*.interface.ts",
      "!**/main.ts",
      "!**/index.ts",
      "!**/__mocks__/**",
      "!**/*.spec.ts",
      "!**/configurations/**",
      "!**/database/**",
      "!**/instrumentation.ts",
      "!**/*.decorator.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "clover",
      "html",
      "json-summary"
    ],
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "coverageThreshold": {
      "global": {
        "branches": 69,
        "functions": 82,
        "lines": 85,
        "statements": 85
      }
    },
    "verbose": true,
    "testTimeout": 1e4
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
