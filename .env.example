# API EXTERNAL
API_EXTERNAL_BASE_URL=https://google.com
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:4173

# APP
APP_NAME=NestJS Starter Kit
APP_HOST=0.0.0.0
APP_PORT=1337
APP_ENV=development
APP_TRUST_PROXY=true

# DATABASE
DATABASE_HOST=localhost
DATABASE_NAME=nestjs_starter_kit
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_PORT=5432
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_ISSUER=nestjs-starter-kit

# OPENTELEMETRY
OTEL_ENABLED=false
OTEL_METRICS_ENABLED=true
OTEL_EXPORT_INTERVAL=30000
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_LOG_LEVEL=info
OTEL_SERVICE_NAME=
OTEL_SERVICE_VERSION=

# THROTTLE
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# QUEUE REDIS
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=

# MAILER
MAIL_FROM=noreply@template.co
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
