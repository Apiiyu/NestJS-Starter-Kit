# API EXTERNAL
API_EXTERNAL_BASE_URL=https://google.com
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:4173

# APP
APP_NAME=NestJS Starter Kit
APP_HOST=0.0.0.0
APP_PORT=1337
APP_ENV=development
APP_TRUST_PROXY=true

# DATABASE
DATABASE_HOST=localhost
DATABASE_NAME=nestjs_starter_kit
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_PORT=5432
# Run pending migrations on boot. Leave false in production: several replicas
# starting together would race for the same lock. Run them as a deploy step.
DATABASE_MIGRATIONS_RUN=false
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# JWT
JWT_SECRET=
# Access token lifetime. Short on purpose: the token carries the user's role, so a
# role change or a disabled account only takes effect once this expires and the client
# rotates. Long sessions come from the refresh token, not from stretching this value.
JWT_EXPIRES_IN=15m
# Refresh token lifetime. Optional — defaults to 7d in jwt-configuration.ts so that
# an existing .env keeps working. This is a duration, not a secret.
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=nestjs-starter-kit

# PROMETHEUS
# Required. Generate a high-entropy value, for example: openssl rand -hex 32
# Scrapers send it as the x-api-key header to GET /api/v1/metrics.
METRICS_API_KEY=

# OPENTELEMETRY
OTEL_ENABLED=false
OTEL_METRICS_ENABLED=false
OTEL_EXPORT_INTERVAL=30000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_LOG_LEVEL=info
OTEL_SERVICE_NAME=
OTEL_SERVICE_VERSION=

# Host-side ports for the Jaeger development container.
JAEGER_UI_PORT=16686
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# THROTTLE
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# QUEUE REDIS
# Separate container from REDIS above (BullMQ jobs must never be evicted, so this
# instance runs noeviction while the cache instance runs allkeys-lru) — different
# default host port (6380) so both containers can publish at once.
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6380
QUEUE_REDIS_PASSWORD=

# MAILER
# Defaults target the local mailpit container (docker-compose service `mailpit`,
# UI at http://localhost:8025). Swap to a real SMTP provider (e.g. Mailtrap
# sandbox.smtp.mailtrap.io:2525) outside local dev.
MAIL_FROM=noreply@template.co
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
# Host-side ports for the mailpit container itself (compose only, not read by the app)
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025
