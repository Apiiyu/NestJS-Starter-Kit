{
  "extends": "./tsconfig.json",
  // `exclude` replaces the parent's array rather than extending it, so every entry
  // tsconfig.json excludes has to be repeated here. `scripts` is the one that bites:
  // without it, `nest build` compiles the build tooling into dist/.
  "exclude": ["node_modules", "test", "dist", "artifacts", "scripts", "**/*spec.ts"]
}
